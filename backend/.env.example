# Copy to .env and change these before deployment. Not committed to git.
STAFF_USERNAME=admin
STAFF_DISPLAY_NAME=MediKiosk Administrator
STAFF_ROLE=admin
STAFF_PIN=change-this-pin

# For individually attributable accounts, provide a JSON array on one line.
# Supported roles: nurse, doctor, admin.
# STAFF_ACCOUNTS_JSON=[{"username":"nurse1","display_name":"Nurse One","role":"nurse","pin":"change-me"},{"username":"doctor1","display_name":"Doctor One","role":"doctor","pin":"change-me"}]

# Speech provider: local, bhashini, or ai4bharat. Any configured remote-provider
# failure automatically falls back to local faster-whisper/Piper.
SPEECH_PROVIDER=local

# Bhashini: obtain the compute callback URL, auth header name/value, and service
# IDs from the mandatory Pipeline Config call. Never commit real credentials.
# BHASHINI_COMPUTE_URL=https://your-pipeline-callback.example/inference
# BHASHINI_AUTH_NAME=Authorization
# BHASHINI_AUTH_VALUE=your-inference-key
# BHASHINI_ASR_SERVICE_ID=your-asr-service-id
# BHASHINI_TTS_SERVICE_ID=your-tts-service-id

# Self-hosted AI4Bharat IndicConformer ASR base URL. MediKiosk calls
# /recognize/{language}. AI4BHARAT_TTS_URL is the JSON wrapper you deploy around
# IndicF5; it accepts {text, language, format} and returns base64 in audio.
# AI4BHARAT_ASR_URL=http://127.0.0.1:4992
# AI4BHARAT_TTS_URL=http://127.0.0.1:4993/synthesize
# AI4BHARAT_API_KEY=
